{
  "$schema": "https://opencode.ai/config.json",
  "model": "novita-ai/tencent/hy3",
  "plugin": [
    "opencode-chat-history-plugin"
  ],
  "provider": {
    "novita-ai": {
      "models": {
        "tencent/hy3": {
          "name": "tencent/hy3"
        }
      }
    },
    "ollama": {
      "models": {
        "glm-5.2:cloud": {
          "_launch": true,
          "name": "glm-5.2:cloud"
        },
        "kimi-k2.7-code:cloud": {
          "_launch": false,
          "name": "kimi-k2.7-code:cloud"
        },
        "gemma4:cloud": {
          "_launch": false,
          "name": "gemma4:cloud"
        },
        "qwen3-vl:235b-cloud": {
          "_launch": false,
          "name": "qwen3-vl:235b-cloud"
        },
        "qwen3-coder-next:cloud": {
          "_launch": false,
          "name": "qwen3-coder-next:cloud"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
